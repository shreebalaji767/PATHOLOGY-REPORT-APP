{
  "name": "BLSSNVJ21 Pathology Report Creator",
  "short_name": "BLSSNVJ21",
  "description": "BLSSNVJ21 browser-based pathology report creation and printing application with offline PWA support and browser-only storage.",
  "start_url": "../",
  "scope": "../",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone",
    "minimal-ui"
  ],
  "orientation": "portrait",
  "background_color": "#eeeeed",
  "theme_color": "#303336",
  "lang": "en-IN",
  "dir": "ltr",
  "categories": [
    "medical",
    "productivity",
    "business"
  ],
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "icons/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ]
}
